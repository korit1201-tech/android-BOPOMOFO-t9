<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- 頂部：候選字列與常駐符號按鈕 -->
    <LinearLayout
        android:id="@+id/layout_candidate_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/kb_candidate_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 最左側常駐特殊符號/方向鍵盤呼叫按鈕 -->
        <Button
            android:textAllCaps="false"
            android:id="@+id/btn_symbol_drawer"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_key_action"
            android:text="✛"
            android:textColor="@color/kb_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <HorizontalScrollView
                android:id="@+id/candidate_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fadingEdgeLength="24dp"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/candidate_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="32dp" />
            </HorizontalScrollView>

            <!-- 展開候選字多列格柵按鈕 (▼) -->
            <Button
            android:textAllCaps="false"
                android:id="@+id/btn_candidate_expand"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_candidate_more"
                android:text="▼"
                android:textColor="@color/kb_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 右側更多候選字指示器 (當候選字超過螢幕時提示使用者可向右拉動) -->
            <TextView
                android:id="@+id/candidate_more_indicator"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="38dp"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/kb_candidate_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:background="@drawable/bg_candidate_more"
                android:visibility="gone" />
            <!-- 橫向懸浮小鍵盤收進邊緣按鈕 (⇲ 收起) -->
            <Button
                android:textAllCaps="false"
                android:id="@+id/btn_floating_dock"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_key_action"
                android:text="⇲"
                android:textColor="@color/kb_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 鍵盤高度拉伸調整把手 (拖動可上下縮放高度) -->
    <FrameLayout
        android:id="@+id/layout_resize_handle"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_resize_pill" />
    </FrameLayout>

    <!-- 主鍵盤區容器 -->
    <FrameLayout
        android:id="@+id/layout_main_frame"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="2dp">

        <!-- 1. 12 宮格佈局 (注音 / 數字 / 9鍵英文 共享) -->
        <LinearLayout
            android:id="@+id/layout_12key"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="visible">

            <!-- 左側區域：符號/注音組合選擇欄 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2">

                <!-- 平時顯示的符號列表 -->
                <LinearLayout
                    android:id="@+id/layout_symbols"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <Button
            android:textAllCaps="false"
                        android:id="@+id/btn_sym_1"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key_action"
                        android:text="？"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="18sp" />

                    <Button
            android:textAllCaps="false"
                        android:id="@+id/btn_sym_2"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key_action"
                        android:text="！"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="18sp" />

                    <Button
            android:textAllCaps="false"
                        android:id="@+id/btn_sym_3"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key_action"
                        android:text="……"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="18sp" />

                    <Button
            android:textAllCaps="false"
                        android:id="@+id/btn_sym_4"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key_action"
                        android:text="："
                        android:textColor="@color/kb_text_primary"
                        android:textSize="18sp" />

                    <Button
            android:textAllCaps="false"
                        android:id="@+id/btn_sym_5"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key_action"
                        android:text="、"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- 輸入注音時的組合列表 -->
                <ScrollView
                    android:id="@+id/scroll_zhuyin_combos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/container_zhuyin_combos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </FrameLayout>

            <!-- 中間 12 宮格 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6"
                android:orientation="vertical">

                <!-- 第 1 列: K1, K2, K3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k1"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄅ ㄉ ㄚ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k2"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄍ ㄐ ㄞ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k3"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄓ ㄗ ㄢ ㄦ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 第 2 列: K4, K5, K6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k4"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄆ ㄊ ㄛ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k5"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄎ ㄑ ㄟ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k6"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄔ ㄘ ㄣ ㄧ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 第 3 列: K7, K8, K9 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k7"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄇ ㄋ ㄜ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k8"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄏ ㄒ ㄠ ㄡ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k9"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄕ ㄙ ㄤ ㄨ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 第 4 列: K10, K11, K12 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k10"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄈ ㄌ ㄝ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k11"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ˇ ˋ ˊ ˙"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.bopomofo.t9ime.ui.SwipeKeyButton
                        android:id="@+id/key_k12"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_key"
                        android:text="ㄖ ㄥ ㄩ"
                        android:textAllCaps="false"
                        android:textColor="@color/kb_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- 右側操作欄 (Backspace, 清空, @) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <Button
            android:textAllCaps="false"
                    android:id="@+id/btn_backspace"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_key_action"
                    android:text="⌫"
                    android:textColor="@color/kb_text_primary"
                    android:textSize="18sp" />

                <Button
            android:textAllCaps="false"
                    android:id="@+id/btn_clear"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_key_action"
                    android:text="清空"
                    android:textColor="@color/kb_text_primary"
                    android:textSize="14sp" />

                <Button
            android:textAllCaps="false"
                    android:id="@+id/btn_sym_at"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_key_action"
                    android:text="@"
                    android:textColor="@color/kb_text_primary"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. 26 鍵英文全鍵盤 (QWERTY Layout) -->
        <LinearLayout
            android:id="@+id/layout_qwerty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- QWERTY 常用符號列: + - * / = ( ) @ _ & -->
            <LinearLayout
                android:id="@+id/qwerty_row_symbols"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.85"
                android:orientation="horizontal" />

            <!-- QWERTY Row 1: Q W E R T Y U I O P -->
            <LinearLayout
                android:id="@+id/qwerty_row_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <!-- QWERTY Row 2: A S D F G H J K L -->
            <LinearLayout
                android:id="@+id/qwerty_row_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <!-- QWERTY Row 3: Shift + Z X C V B N M + Del -->
            <LinearLayout
                android:id="@+id/qwerty_row_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 3. 手寫畫布區域 (Handwriting Layout) -->
        <FrameLayout
            android:id="@+id/layout_handwriting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <com.bopomofo.t9ime.ui.HandwritingCanvasView
                android:id="@+id/handwriting_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_key" />

            <Button
            android:textAllCaps="false"
                android:id="@+id/btn_handwriting_clear"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:layout_gravity="end|bottom"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_action"
                android:text="重寫"
                android:textColor="@color/kb_text_primary"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- 4. 41 鍵大千注音全鍵盤 (Zhuyin Full Layout) -->
        <LinearLayout
            android:id="@+id/layout_zhuyin_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Row 1: ㄅ ㄉ ˇ ˋ ㄓ ˊ ˙ ㄚ ㄞ ㄢ -->
            <LinearLayout
                android:id="@+id/zhuyin_full_row_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <!-- Row 2: ㄆ ㄊ ㄍ ㄐ ㄔ ㄗ ㄧ ㄛ ㄟ ㄣ -->
            <LinearLayout
                android:id="@+id/zhuyin_full_row_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <!-- Row 3: ㄇ ㄋ ㄎ ㄑ ㄕ ㄘ ㄨ ㄜ ㄠ ㄤ -->
            <LinearLayout
                android:id="@+id/zhuyin_full_row_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <!-- Row 4: ㄈ ㄌ ㄏ ㄒ ㄖ ㄙ ㄩ ㄝ ㄡ ㄥ ㄦ -->
            <LinearLayout
                android:id="@+id/zhuyin_full_row_4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 5. 特殊符號抽屜 ＋ 方向鍵編輯盤 (Symbol & D-Pad Panel) -->
        <LinearLayout
            android:id="@+id/layout_symbol_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/kb_bg"
            android:visibility="gone">

            <!-- 頂部 Tab 欄 (可左右橫向捲動的多分頁) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:background="@color/kb_candidate_bg">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <Button
            android:textAllCaps="false"
                            android:id="@+id/tab_sym_fullwidth"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="54dp"
                            android:text="全形"
                            android:textSize="13sp"
                            android:textColor="@color/kb_text_primary" />

                        <Button
            android:textAllCaps="false"
                            android:id="@+id/tab_sym_halfwidth"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="54dp"
                            android:text="半形"
                            android:textSize="13sp"
                            android:textColor="@color/kb_text_primary" />

                        <Button
            android:textAllCaps="false"
                            android:id="@+id/tab_sym_dpad"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="62dp"
                            android:text="方向鍵"
                            android:textSize="13sp"
                            android:textColor="@color/kb_text_primary" />

                        <Button
            android:textAllCaps="false"
                            android:id="@+id/tab_sym_math"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="54dp"
                            android:text="符號"
                            android:textSize="13sp"
                            android:textColor="@color/kb_text_primary" />

                        <Button
            android:textAllCaps="false"
                            android:id="@+id/tab_sym_clipboard"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="68dp"
                            android:text="📋剪貼簿"
                            android:textSize="13sp"
                            android:textColor="@color/kb_text_primary" />

                        <Button
            android:textAllCaps="false"
                            android:id="@+id/tab_sym_emoji"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="64dp"
                            android:text="😀Emoji"
                            android:textSize="13sp"
                            android:textColor="@color/kb_text_primary" />

                        <Button
            android:textAllCaps="false"
                            android:id="@+id/tab_sym_kaomoji"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="66dp"
                            android:text="顏文字"
                            android:textSize="13sp"
                            android:textColor="@color/kb_text_primary" />

                        <Button
            android:textAllCaps="false"
                            android:id="@+id/tab_sym_snippet"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:minWidth="66dp"
                            android:text="常用短語"
                            android:textSize="13sp"
                            android:textColor="@color/kb_text_primary" />
                    </LinearLayout>
                </HorizontalScrollView>


            </LinearLayout>

            <!-- 內容區容器 (ScrollView 承載符號按鈕或方向鍵) -->
            <FrameLayout
                android:id="@+id/container_symbol_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp" />
        </LinearLayout>

        <!-- 6. 候選字展開多列大面板 (Grid Panel) -->
        <LinearLayout
            android:id="@+id/layout_candidate_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/kb_candidate_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 頂部控制列：標題、提示與收合按鈕 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@color/kb_action_key_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tv_candidate_grid_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="全部候選字"
                    android:textColor="@color/kb_text_secondary"
                    android:textSize="13sp" />


                <Button
            android:textAllCaps="false"
                    android:id="@+id/btn_candidate_grid_close"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:text="▲"
                    android:textColor="@color/kb_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 候選字多列捲動區域 -->
            <ScrollView
                android:id="@+id/scroll_candidate_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical">

                <LinearLayout
                    android:id="@+id/container_candidate_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp" />
            </ScrollView>
        </LinearLayout>

    </FrameLayout>

    <!-- 底部功能與控制欄 (123, 括號/模式切換, 逗號, 空格/語言滑動, 句號, 模式樞紐) -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:textAllCaps="false"
            android:id="@+id/btn_mode_123"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_key_action"
            android:text="123"
            android:textColor="@color/kb_text_primary"
            android:textSize="16sp" />

        <com.bopomofo.t9ime.ui.SwipeKeyButton
            android:textAllCaps="false"
            android:id="@+id/btn_qwerty_toggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_key_action"
            android:text="( )"
            android:textColor="@color/kb_text_primary"
            android:textSize="16sp" />

        <Button
            android:textAllCaps="false"
            android:id="@+id/btn_comma"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="0.7"
            android:padding="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_key_action"
            android:text="，"
            android:textColor="@color/kb_text_primary"
            android:textSize="16sp" />

        <!-- 繁/簡 空白鍵 (支援滑動切換繁簡) -->
        <com.bopomofo.t9ime.ui.SwipeKeyButton
            android:textAllCaps="false"
            android:id="@+id/btn_space_swipe"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1.8"
            android:padding="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_key"
            android:text="繁"
            android:textColor="@color/kb_text_secondary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 手機橫向分離式鍵盤中央間隙 (Split Keyboard Spacer) -->
        <View
            android:id="@+id/spacer_bottom_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.0"
            android:visibility="gone" />

        <Button
            android:textAllCaps="false"
            android:id="@+id/btn_period"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="0.7"
            android:padding="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_key_action"
            android:text="。"
            android:textColor="@color/kb_text_primary"
            android:textSize="16sp" />

        <!-- 中/英 切換鍵 (取代原來的放大鏡) -->
        <Button
            android:textAllCaps="false"
            android:id="@+id/btn_lang_toggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1.0"
            android:padding="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_key_action"
            android:text="中/英"
            android:textColor="@color/kb_text_primary"
            android:textSize="14sp" />

        <!-- 全鍵盤專用獨立換行鍵 (方案 A: 全注音與英文全鍵盤共有) -->
        <Button
            android:textAllCaps="false"
            android:id="@+id/btn_full_enter"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1.25"
            android:padding="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/bg_key_action"
            android:text="↵"
            android:textColor="@color/kb_text_primary"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 橫向 9 鍵專屬懸浮底條 (包含拖曳把手與雙向/四角自由縮放錨點) -->
    <RelativeLayout
        android:id="@+id/layout_floating_drag_bar"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="2dp"
        android:visibility="gone">

        <!-- 左下角縮放錨點 (向左/向下拖曳縮放長寬，指向左下↔右上) -->
        <TextView
            android:id="@+id/btn_floating_resize_left"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="⤢"
            android:textColor="@color/kb_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- 中央拖曳移動把手條 -->
        <FrameLayout
            android:id="@+id/floating_drag_handle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/btn_floating_resize_left"
            android:layout_toStartOf="@+id/btn_floating_resize_right"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="60dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_resize_pill" />
        </FrameLayout>

        <!-- 右下角縮放錨點 (向右/向下拖曳自由調整長寬，指向左上↔右下) -->
        <TextView
            android:id="@+id/btn_floating_resize_right"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="⤡"
            android:textColor="@color/kb_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- 橫向懸浮小鍵盤收進邊緣後的迷你浮標 (點擊立即還原展開鍵盤) -->
    <LinearLayout
        android:id="@+id/layout_floating_docked_handle"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_key_action"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_floating_docked_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌨ 喚出注音鍵盤"
            android:textColor="@color/kb_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
