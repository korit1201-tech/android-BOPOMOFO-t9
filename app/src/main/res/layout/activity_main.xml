<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 標題區域 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All's good注音九宮格輸入法"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="支援 T9 智能預測、個人化詞庫記憶與手寫辨識"
            android:textColor="#757575"
            android:textSize="13sp" />

        <!-- 區塊一：系統設定引導 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_key"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ 快速啟用引導"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_enable_ime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="步驟一：在系統設定中啟用輸入法" />

            <Button
                android:id="@+id/btn_select_ime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="步驟二：切換使用此輸入法" />
        </LinearLayout>

        <!-- 區塊：按鍵觸摸震動設定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_key"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📳 按鍵觸控震動設定"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="按鍵觸覺震動反饋"
                    android:textColor="#424242"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_vibration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_vibration_strength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="震動強度調整"
                        android:textColor="#424242"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_vibration_strength_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 ms"
                        android:textColor="#1976D2"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekbar_vibration_strength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:min="5"
                    android:progress="30" />
            </LinearLayout>
        </LinearLayout>

        <!-- 區塊：輸入習慣與發音容錯 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_key"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 輸入習慣與發音容錯"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="調整注音模糊音比對與候選字演算法偏好。"
                android:textColor="#757575"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="發音容錯輸入（前後鼻音模糊）"
                        android:textColor="#424242"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="開啟時提供 ㄣ/ㄥ、ㄢ/ㄤ 容錯候補（精確按鍵始終最優先）；關閉時僅嚴格匹配輸入按鍵。"
                        android:textColor="#757575"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_tolerant_input"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- 區塊：鍵盤外觀與主題配色 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_key"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 鍵盤外觀與主題風格"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="選擇您喜愛的介面配色，支援深色模式與自訂主題風格。"
                android:textColor="#757575"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinner_theme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- 區塊二：個人化詞庫與匯入匯出 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_key"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 個人化詞庫管理 (本機記憶)"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dict_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="目前已記錄：0 個常用專屬詞彙"
                android:textColor="#424242"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="打字時點選越多次的詞，系統會自動加權排在越前面。所有紀錄皆保存在本機，安全不聯網。"
                android:textColor="#757575"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_export_dict"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="📤 匯出詞庫 (.txt)" />

                <Button
                    android:id="@+id/btn_import_dict"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="📥 匯入詞庫 (.txt)" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_clear_dict"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="清空學習紀錄"
                android:textColor="#D32F2F"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 區塊三：即時效果測試輸入框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_key"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️ 打字效果即時測試"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FAFAFA"
                android:hint="點擊這裡喚起鍵盤測試輸入..."
                android:padding="12dp"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 區塊四：版本資訊、作者與更新檢測 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_key"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 關於與版本更新"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_current_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="目前版本：v2.1.0"
                android:textColor="#424242"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_author_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="作者：korit1201-tech"
                android:textColor="#616161"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_github_repo_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🌐 專案主頁：github.com/korit1201-tech/android-BOPOMOFO-t9"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="點擊手動比對 GitHub Releases 最新版本，發現新版可直接在應用內下載並安裝更新。"
                android:textColor="#757575"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🔍 檢查 GitHub 新版本" />
        </LinearLayout>

        <!-- 區塊五：第三方開源語料與授權致謝 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_key"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 第三方開源語料與技術致謝"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="本輸入法之離線詞庫與技術參考以下優秀開源專案，特此致謝：\n\n• 新酷音輸入法 (chewing/libchewing-data)\n  官方繁體中文全量高頻詞庫與注音語料。\n\n• PIME 輸入法平台 (easyprog/pime)\n  啟發跨音節動態規劃組句、游標回退改字與實體外接鍵盤互動架構。\n\n• 琦琦輸入法 (polobread/KeyKey)\n  引用 chichi77Collection (MIT 授權, Copyright 2026 Chui-Ping Cheng)，收錄 29 類現代生活流行語、ACG 動漫、高科技、AI 與生醫法律分類詞庫。\n\n• 小麥注音 (openvanilla/McBopomofo)\n  提供精準字音、音節與注音詞頻參考 (MIT 授權)。\n\n• fcitx5-android-t9-phone (Rizumu85)\n  啟發 12 鍵注音手勢九宮格設計理念。"
                android:textColor="#555555"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_third_party_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🔗 查閱完整第三方開源授權聲明 (THIRD-PARTY-NOTICES.md)"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
